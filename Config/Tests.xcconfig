// The unit test target (NoteCodeTests), in both projects. In the App Store
// project the same target also covers ProTests/.

#include "Shared.xcconfig"

PRODUCT_NAME = $(TARGET_NAME)
PRODUCT_BUNDLE_IDENTIFIER = $(NOTECODE_BUNDLE_ID_PREFIX).NoteCodeTests
// The tests' own bundle, not the app's: the app's version is the edition's.
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

// The tests could also run in a Mac app; the app itself is iOS-only.
SUPPORTED_PLATFORMS = iphoneos iphonesimulator macosx
SWIFT_EMIT_LOC_STRINGS = NO
STRING_CATALOG_GENERATE_SYMBOLS = NO

// The app's product is pinned to NoteCode (App.xcconfig), so this holds in
// both projects.
TEST_HOST = $(BUILT_PRODUCTS_DIR)/NoteCode.app/$(BUNDLE_EXECUTABLE_FOLDER_PATH)/NoteCode
BUNDLE_LOADER = $(TEST_HOST)
